.tab-bar { display: flex; background: #fff; height: 56px; padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -1px 4px rgba(0,0,0,.06); }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; position: relative; }
.tab-item.selected { background: #66508f; border-radius: 12px; }
.tab-icon-wrap { }
.tab-icon { width: 24px; height: 24px; }
.tab-text { font-size: 11px; color: #756e7d; }
.tab-item.selected .tab-text { color: #fff; }
