<view class="page">
  <view class="region-switch">
    <view class="rs-btn {{region === 'china' ? 'active' : ''}}" data-region="china" bindtap="switchRegion">中国地图</view>
    <view class="rs-btn {{region === 'europe' ? 'active' : ''}}" data-region="europe" bindtap="switchRegion">欧洲地图</view>
  </view>
  <view class="map-wrap" catchtouchmove="noop">
    <ec-canvas id="map" canvas-id="map" ec="{{ec}}" />
    <view class="zoom-ctrl">
      <view class="zoom-btn" bindtap="zoomIn">＋</view>
      <view class="zoom-btn" bindtap="zoomOut">－</view>
    </view>
  </view>
  <view class="dish-wrap" wx:if="{{selectedProvince}}">
    <view class="dw-title">{{selectedProvince}} 的特色美食</view>
    <scroll-view scroll-y class="dish-scroll">
      <view class="dish-item {{item.visited ? '' : 'locked'}}" wx:for="{{dishList}}" wx:key="index" data-name="{{item.name}}" bindtap="openCatModal">
        <text>{{item.name}}</text>
        <text wx:if="{{item.visited}}" class="dish-tag">✓</text>
        <text wx:else class="dish-tag lock">未解锁</text>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{modal}}" class="rank-mask" bindtap="closeRankModal" catchtouchmove="noop"></view>
<view wx:if="{{modal}}" class="rank-panel" catchtouchmove="noop">
  <view class="rank-title">{{modal.name}} · 排行榜<text class="rank-close" bindtap="closeRankModal">×</text></view>
  <view class="rank-hint">长按条目拖到另一条上，交换排名</view>
  <scroll-view scroll-y class="rank-scroll" scroll-top="{{rankScrollTop}}" bindscroll="onRankScroll" disable-scroll="{{modal.dragIndex >= 0}}">
    <view
      wx:for="{{modal.foods}}"
      wx:key="id"
      class="rank-item {{modal.dragIndex === index ? 'dragging' : ''}} {{modal.dragIndex >= 0 && modal.overIndex === index && modal.dragIndex !== index ? 'drop-target' : ''}}"
      data-idx="{{index}}"
      bindlongpress="onRankLongPress"
      catch:touchmove="{{modal.dragIndex >= 0 ? 'onRankTouchMove' : ''}}"
      bindtouchend="onRankTouchEnd"
      bindtouchcancel="onRankTouchEnd"
    >
      <text class="rank-no">{{index + 1}}</text>
      <image wx:if="{{item.image_path}}" src="{{item.image_path}}" class="rank-img" mode="aspectFill" />
      <view wx:else class="rank-img rank-img-empty">🍽</view>
      <view class="rank-info">
        <view class="rank-name">{{item.name || '未命名'}}</view>
        <text class="rank-brand" wx:if="{{item.brand_name}}">{{item.brand_name}}</text>
        <text class="rank-meta" wx:if="{{item.repurchase}}">复购{{item.repurchase}}次</text>
      </view>
    </view>
    <view wx:if="{{!modal.foods.length}}" class="rank-empty">该类别还没有记录</view>
  </scroll-view>
</view>
