.page { padding: 12px; padding-bottom: 120px; }
.region-switch { display: flex; margin-bottom: 10px; background: #f0edf6; border-radius: 10px; padding: 4px; }
.rs-btn { flex: 1; text-align: center; padding: 8px 0; font-size: 14px; color: #888; border-radius: 8px; }
.rs-btn.active { background: #2f6b4f; color: #fff; font-weight: 600; }
.map-wrap { position: relative; width: 100%; height: 420px; background: #fff; border-radius: 12px; overflow: hidden; }
.zoom-ctrl { position: absolute; right: 10px; bottom: 12px; display: flex; flex-direction: column; box-shadow: 0 2px 8px rgba(0,0,0,0.12); border-radius: 8px; overflow: hidden; }
.zoom-btn { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #fff; color: #2f6b4f; font-size: 20px; font-weight: 600; }
.zoom-btn + .zoom-btn { border-top: 1px solid #eee; }
.dish-wrap { margin-top: 12px; }
.dw-title { font-size: 15px; font-weight: 600; color: #2f6b4f; margin-bottom: 8px; }
.dish-scroll { max-height: 300px; }
.dish-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: #fff; border-radius: 8px; margin-bottom: 6px; }
.dish-item.locked { color: #bbb; background: #f5f5f5; }
.dish-tag { color: #2c9e5f; font-size: 12px; }
.dish-tag.lock { color: #bbb; }

.rank-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 900; }
.rank-panel { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 16px 16px 0 0; padding: 16px 14px calc(16px + env(safe-area-inset-bottom)); z-index: 901; }
.rank-title { font-size: 16px; font-weight: 600; color: #2f6b4f; display: flex; justify-content: space-between; align-items: center; }
.rank-close { font-size: 22px; color: #999; padding: 0 6px; }
.rank-hint { font-size: 12px; color: #999; margin: 4px 0 8px; }
.rank-scroll { max-height: 56vh; }
.rank-item { display: flex; align-items: center; padding: 8px 10px; background: #f8f7fa; border-radius: 10px; margin-bottom: 8px; border: 2px solid transparent; }
.rank-item.dragging { opacity: 0.85; background: #e8f3ec; border-color: #2f6b4f; }
.rank-item.drop-target { border-color: #b39ddb; background: #f1eaf9; }
.rank-no { width: 30px; font-size: 18px; font-weight: 700; color: #2f6b4f; text-align: center; flex: 0 0 30px; }
.rank-img { width: 52px; height: 52px; border-radius: 8px; flex: 0 0 52px; }
.rank-img-empty { display: flex; align-items: center; justify-content: center; background: #e5e0eb; font-size: 22px; }
.rank-info { margin-left: 10px; min-width: 0; }
.rank-name { font-size: 14px; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-brand { font-size: 12px; color: #999; }
.rank-meta { font-size: 12px; color: #2c9e5f; margin-left: 8px; }
.rank-empty { text-align: center; color: #999; font-size: 13px; padding: 30px 0; }
