.page { padding: 12px; padding-bottom: 120px; }
.region-switch { display: flex; margin-bottom: 10px; background: #f0edf6; border-radius: 10px; padding: 4px; }
.rs-btn { flex: 1; text-align: center; padding: 8px 0; font-size: 14px; color: #888; border-radius: 8px; }
.rs-btn.active { background: #66508f; color: #fff; font-weight: 600; }
.map-wrap { position: relative; width: 100%; height: 420px; background: #fff; border-radius: 12px; overflow: hidden; }
.zoom-ctrl { position: absolute; right: 10px; bottom: 12px; display: flex; flex-direction: column; box-shadow: 0 2px 8px rgba(0,0,0,0.12); border-radius: 8px; overflow: hidden; }
.zoom-btn { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #fff; color: #66508f; font-size: 20px; font-weight: 600; }
.zoom-btn + .zoom-btn { border-top: 1px solid #eee; }
.dish-wrap { margin-top: 12px; }
.dw-title { font-size: 15px; font-weight: 600; color: #66508f; margin-bottom: 8px; }
.dish-scroll { max-height: 300px; }
.dish-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: #fff; border-radius: 8px; margin-bottom: 6px; }
.dish-item.locked { color: #bbb; background: #f5f5f5; }
.dish-tag { color: #2c9e5f; font-size: 12px; }
.dish-tag.lock { color: #bbb; }
