.page { padding: 16px; padding-bottom: 80px; }
.my-header { font-size: 22px; font-weight: 700; color: #66508f; margin-bottom: 16px; }
.stat-card { display: flex; justify-content: space-between; background: #fff; border-radius: 12px; padding: 18px 12px; margin-bottom: 16px; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 22px; font-weight: 700; color: #66508f; }
.stat-label { font-size: 12px; color: #999; margin-top: 4px; }
.info-card { background: #fff; border-radius: 12px; padding: 4px 14px; }
.info-row { display: flex; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid #f0f0f0; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 14px; color: #666; }
.info-value { font-size: 14px; color: #333; }
