<view class="page">
  <view class="my-header">MyFood</view>
  <view class="map-entry" bindtap="gotoMap">美食地图 <text class="me-arrow">›</text></view>
  <view class="stat-card">
    <view class="stat-item">
      <view class="stat-num">{{stats.foods || 0}}</view>
      <view class="stat-label">食物记录</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.photos || 0}}</view>
      <view class="stat-label">照片数</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{days || '-'}}</view>
      <view class="stat-label">服务天数</view>
    </view>
  </view>
  <view class="info-card">
    <view class="info-row"><text class="info-label">今日外网流量</text><text class="info-value">{{traffic || '暂无'}}</text></view>
  </view>
</view>
