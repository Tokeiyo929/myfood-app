.page { padding: 0; padding-bottom: 80px; }
.add-row { background: #fff; display: flex; align-items: center; padding: 8px 16px; }
.grid { display: flex; flex-wrap: wrap; background: #fff; }
.grid-item { width: 25%; box-sizing: border-box; padding: 10px 6px; text-align: center; font-size: 13px; border-bottom: 1px solid #f0f0f0; }
.empty { padding: 40px 0; }

.add-search { display: flex; align-items: center; background: #fff; padding: 8px 12px; }
.add-search van-field { flex: 1; }
.list { background: #fff; }
.suggestions { padding: 4px 12px; background: #fff; }
