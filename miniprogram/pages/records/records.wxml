<view class="page">
  <view class="card">
    <view class="img-box">
      <van-uploader file-list="{{fileList}}" max-count="1" bind:after-read="chooseImage" bind:delete="removeImage" />
    </view>
    <van-field label="名称" value="{{dishName}}" bindinput="onDishName" placeholder="名称（选填）" />
    <view style="margin-top:12px"><van-button type="primary" block bindtap="submit">保存记录</van-button></view>
  </view>
  <view class="hint">保存后可到「历史记录」查看并补充详情</view>
</view>
