<view class="page">
  <!-- 快速记录：上传图片即自动保存 -->
  <view class="quick-card">
    <view class="img-box" bindtap="chooseImage">
    <button class="photo-btn" catchtap="takePhoto">????</button>
      <image wx:if="{{fileList[0] && fileList[0].url}}" src="{{fileList[0].url}}" class="quick-img" mode="aspectFill" />
      <view wx:else class="upload-placeholder">＋
        <text class="upload-txt">点击拍照/选图</text>
      </view>
    </view>
    <view class="quick-hint">{{uploading ? '上传保存中...' : '点击上传图片，自动保存记录'}}</view>
  </view>

  <!-- 今日上传记录 -->
  <view class="today-title">今日上传</view>
  <scroll-view scroll-y class="today-scroll">
    <view class="today-item" wx:for="{{todayRecords}}" wx:key="id" bindtap="openComment" data-id="{{item.id}}">
      <image wx:if="{{item.image_path}}" src="{{item.image_path}}" class="today-img" mode="aspectFill" />
      <view class="today-info">
        <view class="today-name">{{item.name || '未命名'}}</view>
      </view>
    </view>
  </scroll-view>
</view>

<view wx:if="{{commentingId != null}}" class="comment-mask" bindtap="closeComment"></view>
<view wx:if="{{commentingId != null}}" class="comment-panel">
  <view class="comment-title">X<text class="comment-close" bindtap="closeComment">x</text></view>
  <scroll-view scroll-y class="comment-list"><view class="comment-line" wx:for="{{comments}}" wx:key="index">* {{item}}</view></scroll-view>
  <view class="comment-input-row"><input class="comment-input" value="{{commentInput}}" bindinput="onCommentInput" bindconfirm="saveComment" />
  <view class="voice-btn" bindtouchstart="startRecord" bindtouchend="stopRecord">REC</view>
  <van-button type="primary" size="small" bindtap="saveComment">Save</van-button></view></view>