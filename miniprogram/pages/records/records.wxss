.page { padding: 12px; padding-bottom: 20px; }
.card { background: #fff; margin-bottom: 16px; padding: 4px 0 12px; }
.top-row { display: flex; gap: 10px; padding: 4px 12px; }
.img-box { flex: 0 0 88px; }
.name-brand { flex: 1; }
.suggestions { display: flex; flex-wrap: wrap; padding: 4px 16px; }
.chips { display: flex; flex-wrap: wrap; margin: 4px 16px; }
.flavor-pref-row { display: flex; align-items: center; padding: 4px 12px; gap: 12px; }
.flavor-box { flex: 0 0 160px; }
.wheel-wrap { position: relative; width: 150px; height: 150px; }
.flavor-canvas { width: 150px; height: 150px; }
.reset-btn { position: absolute; top: -2px; left: -2px; z-index: 5; color: #66508f; font-size: 18px; padding: 2px 6px; }
.pref-box { flex: 1; display: flex; justify-content: center; }
.preference-panel { display: flex; align-items: center; gap: 6px; }
.pref-slider { height: 150px; width: 36px; }
.pref-side { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.pref-label { font-size: 12px; }
.pref-face { font-size: 26px; }
.ing-row { display: flex; padding: 0 8px; }
.records { margin-top: 8px; }
.record { margin-bottom: 10px; }
.record-card { background: #fff; border-radius: 12px; overflow: hidden; border-left: 4px solid #e0e0e0; }
.record-card.preference-excellent { border-left-color: #2c9e5f; }
.record-card.preference-bad { border-left-color: #c0504d; }
.record-card.preference-good { border-left-color: #e0e0e0; }
.record-main { display: flex; gap: 12px; padding: 12px; }
.record-img { width: 80px; height: 80px; border-radius: 10px; flex-shrink: 0; }
.record-info { flex: 1; min-width: 0; }
.line1 { display: flex; align-items: center; flex-wrap: wrap; }
.record-name { font-weight: 700; font-size: 15px; }
.record-brand { color: #888; font-size: 12px; }
.line2 { display: flex; align-items: center; flex-wrap: wrap; margin-top: 6px; }
.item-label { font-size: 12px; color: #555; margin-right: 4px; }
.repurchase-count { color: #999; font-size: 11px; margin-top: 4px; display: block; }
.loading-hint { text-align: center; color: #999; padding: 14px 0; }
.good-reason { color: #2c9e5f; }
.bad-reason { color: #c0504d; }
.fix-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 100; }
.fix-panel { position: fixed; left: 16px; right: 16px; top: 20%; background: #fff; border-radius: 16px; padding: 16px; z-index: 101; max-height: 70vh; }
.fix-scroll { max-height: 60vh; }
.fix-title { font-size: 17px; font-weight: 700; display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.fix-close { color: #888; font-size: 22px; }
.repurchase-actions { display: flex; gap: 8px; margin-top: 10px; }
