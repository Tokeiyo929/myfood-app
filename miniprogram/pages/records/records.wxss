.page { padding: 12px; padding-bottom: 20px; }
.card { background: #fff; margin-bottom: 16px; padding: 12px; border-radius: 12px; }
.img-box { padding: 0 0 12px; }
.records { margin-top: 8px; }
.record { margin-bottom: 10px; }
.record-card { background: #fff; border-radius: 12px; overflow: hidden; border-left: 4px solid #e0e0e0; }
.record-card.preference-excellent { border-left-color: #2c9e5f; }
.record-card.preference-bad { border-left-color: #c0504d; }
.record-card.preference-good { border-left-color: #e0e0e0; }
.record-main { display: flex; gap: 12px; padding: 12px; }
.record-img { width: 80px; height: 80px; border-radius: 10px; flex-shrink: 0; }
.record-info { flex: 1; min-width: 0; }
.line1 { display: flex; align-items: center; flex-wrap: wrap; }
.record-name { font-weight: 700; font-size: 15px; }
.record-brand { color: #888; font-size: 12px; }
.line2 { display: flex; align-items: center; flex-wrap: wrap; margin-top: 6px; }
.item-label { font-size: 12px; color: #555; margin-right: 4px; }
.repurchase-count { color: #999; font-size: 11px; margin-top: 4px; display: block; }
.loading-hint { text-align: center; color: #999; padding: 14px 0; }
.suggestions { display: flex; flex-wrap: wrap; padding: 2px 0; }
.chips { display: flex; flex-wrap: wrap; margin: 2px 0; }
.flavor-pref-row { display: flex; align-items: center; justify-content: center; gap: 12px; }
.flavor-box { flex: 0 0 180px; display: flex; justify-content: center; }
.wheel-wrap { position: relative; width: 180px; height: 180px; }
.flavor-canvas { width: 180px; height: 180px; }
.reset-btn { position: absolute; top: -2px; left: -2px; z-index: 5; color: #66508f; font-size: 18px; padding: 2px 6px; }
.pref-box { flex: 1; display: flex; justify-content: center; align-items: center; }
.pref-custom { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.pref-face { font-size: 24px; line-height: 1; }
.pref-track { position: relative; width: 24px; height: 140px; background: #e5dff0; border-radius: 12px; }
.pref-fill { position: absolute; left: 0; bottom: 0; width: 100%; background: #66508f; border-radius: 12px; }
.pref-thumb { position: absolute; left: -6px; width: 36px; height: 36px; background: #66508f; border-radius: 50%; transform: translateX(-25%); }
.pref-label { font-size: 12px; }
.ing-row { display: flex; gap: 8px; align-items: center; }
.ing-main { flex: 1; min-width: 0; }
.amount-field { flex: 0 0 50%; }
.reason-area { margin: 4px 0; }
.reason-textarea { width: 100%; min-height: 50px; box-sizing: border-box; padding: 6px 10px; font-size: 13px; background: #f7f7f9; border-radius: 8px; }

/* 详情面板 */
.fix-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); z-index: 100; }
.fix-panel { position: fixed; left: 8px; right: 8px; top: 50%; transform: translateY(-50%); background: #fff; border-radius: 14px; padding: 10px; z-index: 101; max-height: 90vh; overflow: hidden; }
.fix-title { font-size: 16px; font-weight: 700; display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.fix-close { color: #888; font-size: 26px; padding: 0 4px; }
.section-label { font-size: 12px; font-weight: 600; color: #66508f; margin: 6px 0 2px; }
.detail-section { margin-bottom: 2px; }
.cat-field { width: 100%; }
