.page { padding: 12px; padding-bottom: 120px; }
.img-strip { white-space: nowrap; padding: 4px 0 12px; }
.img-item { display: inline-block; width: 90px; margin-right: 10px; text-align: center; }
.img-item.selected .strip-img { border: 3px solid #66508f; }
.strip-img { width: 90px; height: 90px; border-radius: 10px; border: 3px solid transparent; box-sizing: border-box; }
.strip-name { font-size: 12px; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.detail-body { padding-top: 4px; }
.detail-empty { padding-top: 60px; }
.section-label { font-size: 12px; font-weight: 600; color: #66508f; margin: 10px 0 4px; }
.detail-section { margin-bottom: 4px; }
.cat-field { width: 100%; }
.suggestions { display: flex; flex-wrap: wrap; padding: 2px 0; }
.chips { display: flex; flex-wrap: wrap; margin: 2px 0; }
.repurchase-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; }
.section-inline-label { font-size: 14px; color: #666; }
.flavor-pref-row { display: flex; align-items: center; justify-content: center; gap: 12px; }
.flavor-box { flex: 0 0 180px; display: flex; justify-content: center; }
.wheel-wrap { position: relative; width: 180px; height: 180px; }
.flavor-canvas { width: 180px; height: 180px; }
.reset-btn { position: absolute; top: -2px; left: -2px; z-index: 5; color: #66508f; font-size: 18px; padding: 2px 6px; }
.pref-box { flex: 1; display: flex; justify-content: center; align-items: center; }
.pref-custom { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.pref-face { font-size: 24px; line-height: 1; }
.pref-track { position: relative; width: 24px; height: 140px; background: #e5dff0; border-radius: 12px; }
.pref-fill { position: absolute; left: 0; bottom: 0; width: 100%; background: #66508f; border-radius: 12px; }
.pref-thumb { position: absolute; left: 50%; width: 24px; height: 24px; margin-left: -12px; background: #66508f; border-radius: 50%; }
.pref-label { font-size: 12px; }
.comment-list { margin-bottom: 6px; }
.comment-item { display: flex; align-items: center; font-size: 13px; color: #555; padding: 3px 0; }
.comment-txt { flex: 1; }
.comment-del { color: #ee0a24; font-size: 12px; margin-left: 8px; padding: 4px 6px; }
.comment-input-row { display: flex; gap: 8px; align-items: center; }
.comment-input { flex: 1; border: 1px solid #e5dff0; border-radius: 8px; padding: 8px 10px; font-size: 14px; }
.voice-btn { width: 40px; height: 40px; border-radius: 50%; background: #66508f; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; flex: 0 0 40px; }
.ing-row { display: flex; gap: 8px; align-items: center; }
.ing-main { flex: 1; min-width: 0; }
.amount-field { flex: 0 0 50%; }
.action-row { display: flex; gap: 8px; margin-top: 16px; }
.save-btn { flex: 1; }
.del-btn { flex: 0 0 90px; }
