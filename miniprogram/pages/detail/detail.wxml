<view class="page">
  <scroll-view class="img-strip" scroll-x="{{true}}" scroll-into-view="{{scrollIntoId}}" scroll-with-animation>
    <view class="img-item {{selectedId === item.id ? 'selected' : ''}}" wx:for="{{records}}" wx:key="id" id="img-{{item.id}}" bindtap="selectImage" bindlongpress="replaceImage" data-id="{{item.id}}">
      <image wx:if="{{item.image_path}}" src="{{item.image_path}}" mode="aspectFill" class="strip-img" />
      <view class="strip-name">{{item.name || '未命名'}}</view>
    </view>
  </scroll-view>

  <view class="detail-body" wx:if="{{editId != null}}">
    <view class="detail-section">
      <view class="section-label-row"><view class="section-label">基本信息</view><view class="ocr-btn" bindtap="startOcr">📷 OCR识别</view></view>
      <van-field label="产品" model:value="{{dishName}}" bindinput="onDishName" placeholder="产品名称" />
      <van-field label="品牌" model:value="{{brandName}}" bindinput="onBrandName" placeholder="品牌" />
      <van-field label="原价" model:value="{{priceOrig}}" type="digit" bindinput="onPriceOrig" placeholder="原价" />
      <van-field label="折扣价" model:value="{{priceDisc}}" type="digit" bindinput="onPriceDisc" placeholder="选填" />
      <view class="worth-row">
        <view class="section-inline-label">值不值得</view>
        <view class="worth-opts">
          <view class="worth-opt {{worthIt === 'yes' ? 'active' : ''}}" data-v="yes" bindtap="onWorthIt">值</view>
          <view class="worth-opt {{worthIt === 'no' ? 'active' : ''}}" data-v="no" bindtap="onWorthIt">不值</view>
        </view>
      </view>
      <view class="repurchase-row">
        <view class="section-inline-label">复购</view>
        <text class="repurchase-val">{{currentRepurchase || 0}} 次</text>
        <text class="repurchase-prev" wx:if="{{prevRecordLabel}}">上次记录：{{prevRecordLabel}}</text>
      </view>
      <van-field label="类别" value="{{categorySearch}}" bindinput="onCategorySearch" placeholder="搜索产品类别" class="cat-field" />
      <view class="suggestions" wx:if="{{categorySuggestions.length}}">
        <van-tag wx:for="{{categorySuggestions}}" wx:key="*this" data-name="{{item}}" bindtap="pickCategory" style="margin:4px">{{item}}</van-tag>
      </view>
      <view class="chips" wx:if="{{selectedCategory}}">
        <van-tag closeable type="warning" bindtap="removeCategory">{{selectedCategory}}</van-tag>
      </view>
    </view>

    <view class="detail-section" wx:if="{{flavors.length && preferenceOptions.length}}">
      <view class="section-label">味道与偏好</view>
      <view class="flavor-pref-row">
        <view class="flavor-box">
          <view class="wheel-wrap" wx:if="{{!ocrOverlay}}">
            <view class="reset-btn" bindtap="resetFlavors">↻</view>
            <canvas canvas-id="flavorWheel" id="flavorWheel" class="flavor-canvas" width="180" height="180" catchtouchstart="onWheelTouch" catchtouchmove="onWheelMove" />
          </view>
        </view>
        <view class="pref-box">
          <view class="pref-custom">
            <text class="pref-face">{{preferenceFace}}</text>
            <view class="pref-track" bindtouchstart="onPrefTouch" catchtouchmove="onPrefMove">
              <view class="pref-fill" style="height: {{prefPercent}}%"></view>
              <view class="pref-thumb" style="bottom: {{prefBottom}}px"></view>
            </view>
            <text class="pref-label">{{preferenceLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-label">评论</view>
      <view class="comment-list" wx:if="{{comments.length}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="index">
          <text class="comment-txt" bindtap="editComment" data-idx="{{index}}">· {{item}}</text>
          <text class="comment-del" bindtap="deleteComment" data-idx="{{index}}">删除</text>
        </view>
      </view>
      <view class="comment-input-row">
        <textarea class="comment-input" value="{{commentInput}}" bindinput="onCommentInput" placeholder="添加评论" auto-height maxlength="-1" confirm-type="send" bindconfirm="saveDetail" />
        <view class="voice-btn" bindtouchstart="onVoiceStart" bindtouchend="onVoiceEnd" bindtouchcancel="onVoiceEnd">🎤</view>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-label">原料</view>
      <view class="ing-row">
        <van-field label="原料" value="{{ingredientSearch}}" bindinput="onIngredientSearch" placeholder="原料" class="ing-main" />
        <van-field label="含量%" value="{{ingredientAmount}}" type="digit" bindinput="onIngredientAmount" placeholder="%" class="amount-field" />
      </view>
      <view class="ing-preview" wx:if="{{ingredientPreview}}" bindtap="confirmIngredient">＋ 确认添加：{{ingredientPreview.name}}{{ingredientPreview.amount != null ? ' (' + ingredientPreview.amount + '%)' : ''}}</view>
      <view class="chips">
        <van-tag closeable wx:for="{{ingredients}}" wx:key="index" data-idx="{{index}}" bindtap="removeIngredient" style="margin:4px">{{item.name}}{{item.amount != null ? '(' + item.amount + '%)' : ''}}</van-tag>
      </view>
    </view>

    <view class="action-row">
      <van-button type="primary" block bindtap="saveDetail" class="save-btn">保存</van-button>
      <van-button type="danger" bindtap="deleteCurrent" class="del-btn">删除</van-button>
    </view>
  </view>

  <view class="detail-empty" wx:if="{{editId == null}}"><van-empty description="请在历史记录中选择一条记录" /></view>
</view>
<view class="ocr-overlay" wx:if="{{ocrOverlay}}" catchtouchmove="noop" catchtap="noop">
  <view class="ocr-panel" catchtouchstart="noop">
    <view class="ocr-head">
      <text class="ocr-title">在图上点选文字</text>
      <text class="ocr-close" catchtap="closeOcr">完成</text>
    </view>
    <view class="ocr-targets">
      <view class="ocr-target {{ocrTarget === 'name' ? 'active' : ''}}" data-t="name" catchtap="setOcrTarget">产品名称</view>
      <view class="ocr-target {{ocrTarget === 'brand' ? 'active' : ''}}" data-t="brand" catchtap="setOcrTarget">品牌名</view>
      <view class="ocr-target {{ocrTarget === 'ingredient' ? 'active' : ''}}" data-t="ingredient" catchtap="setOcrTarget">原料</view>
    </view>
    <view class="ocr-hint">已选：{{ocrBuiltText || '（空）'}} <text class="ocr-add" catchtap="addToOcrField" wx:if="{{ocrBuiltText}}">＋添加</text><text class="ocr-clear" catchtap="clearOcrBuilt" wx:if="{{ocrBuiltText}}">清空</text></view>
    <scroll-view scroll-y class="ocr-img-wrap">
      <view class="ocr-chars">
        <view wx:for="{{ocrItems}}" wx:key="key"
          class="ocr-char {{ocrPicked[item.key] ? 'picked' : ''}}"
          data-key="{{item.key}}" catchtouchstart="ocrTouchStart" catchtouchmove="ocrTouchMove" catchtouchend="ocrTouchEnd">{{item.ch}}</view>
      </view>
    </scroll-view>
  </view>
</view>
