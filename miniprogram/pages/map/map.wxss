.page { padding: 12px; padding-bottom: 80px; }
.map-wrap { width: 100%; height: 480px; background: #fff; border-radius: 12px; overflow: hidden; }
.province-foods { margin-top: 12px; }
.pf-title { font-size: 15px; font-weight: 600; color: #66508f; margin-bottom: 8px; }
.pf-list { display: flex; flex-wrap: wrap; gap: 8px; }
.pf-item { width: 30%; background: #fff; border-radius: 10px; padding: 8px; text-align: center; }
.pf-img { width: 100%; height: 80px; border-radius: 8px; }
.pf-name { font-size: 12px; margin-top: 4px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
